GUAC_TAG=1.6.0
# https://guacamole.apache.org/releases/

POSTGRES_TAG=17
# unable to find compatibility matrix for guacamole
# but postgres 17 works so far

PROXY_BRIDGE=172.31.255.255
# update this to your proxy bridge or IP binding

GUAC_HOST_PORT=7000
# this is the port the guac web app will listen
# ensure the reverse proxy uses this port and proxy bridge combo