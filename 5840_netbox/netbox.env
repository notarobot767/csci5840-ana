# Database Settings (PostgreSQL 15+ is required)
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox_secure_db_password_here
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=netbox_secure_db_password_here

# Cache & Queue (Valkey / Redis)
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=valkey_secure_password_here
REDIS_CACHE_HOST=valkey-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=valkey_secure_password_here

# NetBox Application Settings
SECRET_KEY=88cbf78bec1fe2ae2366f1d3cfe468aaba381b4fe9fdc55acec0320d28b1204f
ALLOWED_HOSTS=*
DB_WAIT_TIMEOUT=180
REDIS_WAIT_TIMEOUT=180
METRICS_ENABLED=false

# Auto-created Initial Admin Account
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin_secure_password_here
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567