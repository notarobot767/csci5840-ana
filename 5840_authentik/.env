PROXY_BRIDGE=172.31.255.255
# update this to your proxy bridge or IP binding

AUTHENTIK_HOST_PORT=7015
# this is the port the authentik web app will listen
# ensure the reverse proxy uses this port and proxy bridge combo

AUTHENTIK_TAG=2026.8
# use latest release major version
# for example, a tag of 2025.2 will use latest minor version
# which could be 2025.2.4
# https://docs.goauthentik.io/docs/releases

AUTHENTIK_HOST=authentik.badcode.app
# change me to your domain

AUTHENTIK_DEFAULT_HTTP_SCHEME=https
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=0.0.0.0/0
# https://docs.goauthentik.io/docs/install-config/configuration/