###########
# setup SSH
###########
hostname {{ item.hostname | default('# MISSING! #') }}
ip domain name {{ domain.nipr | default('# MISSING! #') }}
!
system mode insecure
!
vrf definition MGMT_INT
  address-family ipv4
!
interface GigabitEthernet 1
  no ip proxy-arp
  no ip redirects
  no shut
!
interface GigabitEthernet 1.222
  description NIPR_MGMT
  encapsulation dot1Q 222
  vrf forwarding MGMT_INT
  !
  ip address {{ item.nipr.interface.mgmt.ip.address | default('# MISSING! #') }} {{ item.nipr.interface.mgmt.ip.netmask | default('# MISSING! #') }}
  no ip proxy-arp
  no ip redirects
  !
  no shutdown
!
# careful not to overwrite your keys!
crypto key generate ec keysize 384 label MGMT_SSH
ip ssh rsa keypair MGMT_SSH
!
# users from user list
{% for user in users %}
username {{ user.name }} privilege 15 algorithm-type sha256 secret {{ user.secret }}
{% endfor %}
!
ip access-list standard MGMT_PROTECT
  10 permit {{ item.nipr.interface.mgmt.ip.address | default('# MISSING! #') }} {{ item.nipr.interface.mgmt.ip.wildcard | default('# MISSING! #') }}
  20 permit 143.86.179.226 0.0.0.31
  999 deny any log
!
line vty 0 4
  transport input ssh
  transport output ssh
  login local
  logging synchronous
  access-class MGMT_PROTECT in vrfname MGMT_INT
!
##################
# Remote mgmt user
##################
username guac privilege 15
!
ip ssh pubkey-chain
  username guac
    key-hash ssh-ed25519 6B466145C8295E0BF2902E1BC8814EE0811ADD6DCE532082CB102895AD1EFDBB 359ttsb
!
########################
# Default route for MGMT
########################
ip route vrf MGMT_INT 0.0.0.0 0.0.0.0 GigabitEthernet 1.222 {{ item.nipr.interface.mgmt.ip.gateway | default('# MISSING! #') }}
!
##############
# restrict SSH
##############
ip ssh server algorithm hostkey ecdsa-sha2-nistp521 ecdsa-sha2-nistp384
ip ssh server algorithm kex curve25519-sha256 curve25519-sha256@libssh.org ecdh-sha2-nistp521 ecdh-sha2-nistp384
ip ssh server algorithm encryption chacha20-poly1305@openssh.com aes256-gcm aes256-gcm@openssh.com aes128-gcm aes128-gcm@openssh.com aes256-ctr aes192-ctr aes128-ctr
ip ssh server algorithm mac hmac-sha2-512-etm@openssh.com hmac-sha2-256-etm@openssh.com hmac-sha2-512 hmac-sha2-256
!
ip ssh source-interface GigabitEthernet 1.222
ip ssh version 2
ip ssh dscp 40
!
##################
# restrict console
##################
line console 0
  logging synchronous
  transport output ssh
!
#############
# disable aux
#############
line aux 0
  no exec
  transport input none
!
######
# misc
######
ip tcp path-mtu-discovery
no ip domain lookup
no ip boot server
no ip bootp server
no ip dns server
no ip finger
no ip forward-protocol nd
no ip http server
no ip http secure-server
no ip rcmd rcp-enable
no ip rcmd rsh-enable
no ip source-route
!
ip arp gratuitous none
no ip gratuitous-arps
!
service nagle
service tcp-keepalives-in
service tcp-keepalives-out
service password-encryption
!
no service config
no service finger
no service tcp-small-servers
no service udp-small-servers
no service pad
no service call-home
no service config
!
no boot network
vtp mode off
spanning-tree mode rapid-pvst
!
#############
# Enable IPv6
#############
ipv6 unicast-routing
ipv6 multicast-routing
!
##########################
# Cisco Express Forwarding
##########################
ip cef distributed
ipv6 cef distributed
!
############
# enable cdp
############
cdp run
!
###############
# rate-limiting
###############
ip icmp rate-limit unreachable 500 log
ip icmp rate-limit unreachable df 500 log
ip igmp limit 500
!
#################
# NIPR Router VRF
#################
vrf definition NIPR_ROUTER
  address-family ipv4
  address-family ipv6
!
########
# OSPFv2
########
router ospf 21 vrf NIPR_ROUTER
  passive-interface default
  area 1 range {{ item.nipr.ip_space.ip.network | default('# MISSING! #') }} {{ item.nipr.ip_space.ip.netmask | default('# MISSING! #') }}
  router-id {{ item.nipr.interface.loopback_7.ip.address | default('# MISSING! #') }}
!
########
# OSPFv3
########
router ospfv3 21
  address-family ipv4 unicast
    passive-interface default
    router-id {{ item.xless.interface.loopback_0.ip.address | default('# MISSING! #') }}
  exit-address-family
!
############
# loopback 0
############
interface Loopback 0
  description xless loop
  !
  ip address {{ item.xless.interface.loopback_0.ip.address | default('# MISSING! #') }} 255.255.255.255
  no ip redirects
  no ip proxy-arp
  no ip unreachables
  ip pim sparse-mode
  !
  ipv6 enable
  no ipv6 redirects
  !
  ospfv3 21 ipv4 area 0
  ospfv3 21 ipv4 network point-to-point
  !
  no shutdown
!
############
# loopback 7
############
interface Loopback 7
  description nipr
  vrf forwarding NIPR_ROUTER
  !
  ip address {{ item.nipr.interface.loopback_7.ip.address | default('# MISSING! #') }} 255.255.255.255
  no ip redirects
  no ip proxy-arp
  ip pim sparse-mode
  !
  ip ospf 21 area 1
  ip ospf network point-to-point
  !
  no shutdown
!
#################
# NIPR T2R to FWH
#################
interface GigabitEthernet 1.324
  description NT2R to NFWH
  encapsulation dot1Q 324
  vrf forwarding NIPR_ROUTER
  !
  ip address {{ item.nipr.interface.t2r_fwh.ip.address | default('# MISSING! #') }} {{ item.nipr.interface.t2r_fwh.ip.netmask | default('# MISSING! #') }}
  no ip redirects
  no ip proxy-arp
  !
  no shutdown
  !
ip route vrf NIPR_ROUTER {{ item.nipr.ip_space.ip.network | default('# MISSING! #') }} {{ item.nipr.ip_space.ip.netmask | default('# MISSING! #') }} GigabitEthernet 1.324 {{ item.nipr.interface.t2r_fwh.ip.gateway | default('# MISSING! #') }}
# ensure owned NIPR LAN IP space queries never sent over WAN
# this prevents trying to route externally to IP Space owned by node
!
###########
# multicast
###########
ip multicast-routing distributed
ip multicast-routing vrf NIPR_ROUTER distributed
!
ip pim spt-threshold infinity
ip pim register-rate-limit 512000
ip pim register-source Loopback0
!
ip access-list standard ACL_CANDIDATE_RP_MCG
  remark Longer-Bit match Adjusted per CI Type
  remark THIS NODE CAN BE RP FOR THESE GROUPS
  permit 224.0.0.0 15.255.255.255
!
ip pim vrf NIPR_ROUTER spt-threshold infinity
ip pim vrf NIPR_ROUTER bsr-candidate Loopback7 4 1
ip pim vrf NIPR_ROUTER rp-candidate Loopback7 group-list ACL_CANDIDATE_RP_MCG priority 255
ip pim vrf NIPR_ROUTER register-rate-limit 512000
ip pim vrf NIPR_ROUTER register-source Loopback7
!
########
# INE CT
########
interface GigabitEthernet 1.176
  shutdown
  description INE-CT
  encapsulation dot1Q 176
  !
  ip addr {{ item.xless.interface.taclane_ct.ip.address | default('# MISSING! #') }} {{ item.xless.interface.taclane_ct.ip.netmask | default('# MISSING! #') }}
  ip mtu 1484
  ip tcp adjust-mss 1444
  ip pim sparse-mode
  no ip proxy-arp
  no ip redirects
  no ip unreachables
  !
  ipv6 enable
  ipv6 mtu 1484
  no ipv6 redirects
  !
  ospfv3 21 ipv4 area 0 
  !
  no shutdown
!
#####################
# XLESS Untrusted PnP
#####################
interface GigabitEthernet 1.7
  description XLESS Untrusted PnP Connection
  encapsulation dot1Q 7
  !
  ip addr {{ item.xless.interface.pnp.ip.address | default('# MISSING! #') }} {{ item.xless.interface.pnp.ip.netmask | default('# MISSING! #') }}
  ip pim sparse-mode
  no ip proxy-arp
  no ip redirects
  !
  ipv6 enable
  no ipv6 redirects
  !
  ospfv3 21 ipv4 area 0
  !
  no shutdown
!
################
# IVPN Interface
################
vrf definition INET_UNDERLAY
  address-family ipv4
  address-family ipv6
!
object-group network AZUGAIT3
  host 52.181.181.174
object-group network RHN3GAIT
  host 157.96.84.211
object-group network AZUGAIT_IVPN
  group-object AZUGAIT3
  group-object RHN3GAIT
!
ip access-list extended INET_ACL_IN
  permit udp any eq bootps any eq bootpc
  permit udp object-group AZUGAIT_IVPN eq isakmp any eq isakmp
  permit udp object-group AZUGAIT_IVPN eq non500-isakmp any eq non500-isakmp
  permit icmp host 198.97.190.53 any echo-reply
!
interface GigabitEthernet 1.169
  description INET_UNDERLAY
  vrf forwarding INET_UNDERLAY
  encapsulation dot1Q 169
  !
  ip access-group INET_ACL_IN in
  ip address dhcp
  no ip dhcp client request domain-name
  no ip dhcp client request dns-nameserver
  no ip proxy-arp
  no ip redirects
  !
  no shutdown
!
#############
# IVPN Crypto
#############
crypto logging ikev2
crypto logging session
crypto isakmp enable
!
crypto pki trustpoint GAITIVPN
  enrollment terminal
  serial-number none
  fqdn none
  ip-address none
  subject-name cn=dynamic.jntc.army.mil,ou={{ item.node.number | default('# MISSING! #') }}
  revocation-check none
  eckeypair GAITEC
  hash sha384
!
interface tunnel 47
!
crypto ikev2 client flexvpn GAIT
  peer 1 157.96.84.211   !RHN3GAIT (Liberty RHN On-Premise)
  peer 2 52.181.181.174  !AZUGAIT3 (Azure-CONUS-East)
  peer 3 52.182.34.85    !AZURE6   (Azure-CONUS-East)
  client connect Tunnel47
!
ip route vrf INET_UNDERLAY 52.181.181.174 255.255.255.255 GigabitEthernet 1.169 dhcp   !AZUGAIT3 (Azure-CONUS-East)
ip route vrf INET_UNDERLAY 157.96.84.211 255.255.255.255 GigabitEthernet 1.169 dhcp    !RHN3GAIT (Liberty RHN On-Premise)
ip route vrf INET_UNDERLAY 198.97.190.53 255.255.255.255 GigabitEthernet 1.169 dhcp    !DoD DNS IP To test internet connectivity
ip route vrf INET_UNDERLAY 0.0.0.0 0.0.0.0 null0
!
crypto pki certificate map CERT_MAP_GAIT 10
 subject-name co ou = gait
!
crypto ikev2 proposal IKEV2_PROPOSAL_IVPN
  encryption aes-cbc-256
  integrity sha384
  group 20
no crypto ikev2 proposal default
!
crypto ikev2 policy IKEV2_POLICY_IVPN
  match fvrf INET_UNDERLAY
  proposal IKEV2_PROPOSAL_IVPN
no crypto ikev2 policy default
!
crypto ikev2 profile IKEV2_PROFILE_IVPN
  description MATCH AZURE CERTIFICATE FOR XLESS-OVER-INET BACKHAUL
  match certificate CERT_MAP_GAIT
  match fvrf INET_UNDERLAY
  identity local dn
  authentication local ecdsa-sig
  authentication remote ecdsa-sig
  pki trustpoint GAITIVPN
  dpd 20 5 periodic
!
crypto ipsec transform-set IPSEC_XFORM_AES256_SHA384_IVPN esp-aes 256 esp-sha384-hmac
  mode transport require
no crypto ipsec transform-set default
!
crypto ipsec profile IPSEC_PROFILE_IVPN_GENERIC
  description MATCH XFORM AND IKE PARAMETERS FOR INTERNET VPN
  set transform-set IPSEC_XFORM_AES256_SHA384_IVPN
  set ikev2-profile IKEV2_PROFILE_IVPN
no crypto ipsec profile default
!
crypto ikev2 fragmentation mtu 1392
!
key chain KC_OSPFV3_XCOMX
  key 1
    key-string OSPFXCOMX
    cryptographic-algorithm hmac-sha-512
!
#############
# IVPN Tunnel
#############
interface Tunnel 47
  shutdown
  description GAIT IVPN
  !
  ip unnumbered Loopback0
  ip mtu 1392
  ip tcp adjust-mss 1352
  ip pim sparse-mode
  no ip redirects
  no ip proxy-arp
  !
  ipv6 enable
  ipv6 mtu 1392
  no ipv6 redirects
  !
  ospfv3 21 cost 20000
  ospfv3 21 ipv4 area 0
  ospfv3 21 ipv4 network point-to-point
  ospfv3 authentication null
  ospfv3 21 ipv4 authentication key-chain KC_OSPFV3_XCOMX
  !
  tunnel vrf INET_UNDERLAY
  tunnel source GigabitEthernet 1.169
  tunnel destination dynamic
  tunnel protection ipsec profile IPSEC_PROFILE_IVPN_GENERIC
  !
  no shutdown
!
router ospfv3 21
  address-family ipv4 unicast
    no passive-interface Tunnel47
  exit-address-family
!
################
# HSRL Interface
################
object-group network OG_NET_HSRL_UNDERLAY
  description HSRL_UNDERLAY NETWORK
  host 169.254.0.1
!
object-group service OG_SVC_HSRL_SERVICES
  udp eq bootpc 
  udp eq isakmp
  esp
  udp eq non500-isakmp
  icmp echo
  icmp echo-reply
!
ip access-list extended ACL_HSRL_UNDERLAY_IN
  10 permit object-group OG_SVC_HSRL_SERVICES object-group OG_NET_HSRL_UNDERLAY any
!
vrf definition HSRL_UNDERLAY
  address-family ipv4
!
interface GigabitEthernet 1.700
  description HSRL_UNDERLAY
  vrf forwarding HSRL_UNDERLAY
  encapsulation dot1Q 700
  !
{% if item.hsrl.interface.ip.address is defined %}
  ip address {{ item.hsrl.interface.ip.address }} 255.255.255.0
{% endif %}
  ip access-group ACL_HSRL_UNDERLAY_IN in
  no ip proxy-arp
  no ip redirects
  !
  no shutdown
!
#############
# HSRL Crypto
#############
crypto ikev2 proposal IKEV2_PROPOSAL_AES256_PRF512_SHA384_GRP20 
  encryption aes-cbc-256
  prf sha512
  integrity sha384
  group 20
no crypto ikev2 proposal default
!
crypto ikev2 policy IKEV2_POLICY_ALL_GAIT 
  match fvrf HSRL_UNDERLAY
  proposal IKEV2_PROPOSAL_AES256_PRF512_SHA384_GRP20
no crypto ikev2 policy default
!
crypto ikev2 keyring IKEV2_KEYRING_HSRL_ALL
  peer GAIT.HSRL.UPLINK
    address 169.254.0.1
    identity fqdn GAIT.HSRL.UPLINK
    pre-shared-key FLEX.{{ item.node.number | default('# MISSING! #') }}
!
crypto ikev2 profile IKEV2_PROFILE_HSRL_ALL
  match fvrf HSRL_UNDERLAY
  match identity remote fqdn GAIT.HSRL.UPLINK
  identity local fqdn {{ item.node.number | default('# MISSING! #') }}.HSRL.GAIT
  authentication remote pre-share
  authentication local pre-share
  keyring local IKEV2_KEYRING_HSRL_ALL
  dpd 20 5 periodic
!
crypto ipsec transform-set IPSEC_XFORM_GCM256_TRANSPORT esp-gcm 256 
  mode transport require
crypto ipsec transform-set IPSEC_XFORM_GCM256_TUNNEL esp-gcm 256 
  mode tunnel
no crypto ipsec transform-set default
!
crypto ipsec profile IPSEC_PROFILE_HSRL_TRANSPORT
  set security-association lifetime seconds 28800
  set transform-set IPSEC_XFORM_GCM256_TRANSPORT 
  set pfs group20
  set ikev2-profile IKEV2_PROFILE_HSRL_ALL
!
crypto ipsec profile IPSEC_PROFILE_HSRL_TUNNEL
  set security-association lifetime seconds 28800
  set transform-set IPSEC_XFORM_GCM256_TUNNEL 
  set pfs group20
  set ikev2-profile IKEV2_PROFILE_HSRL_ALL
no crypto ipsec profile default
!
#############
# HSRL tunnel
#############
interface Tunnel8191812
  shutdown
  description GAIT HSRL
  !
  ip address negotiated
  ip mtu 1392
  ip tcp adjust-mss 1352
  ip pim sparse-mode
  no ip redirects
  no ip proxy-arp
  !
  ipv6 enable
  ipv6 mtu 1392
  no ipv6 redirects
  !
  ospfv3 authentication null
  ospfv3 21 network point-to-point
  ospfv3 21 ipv4 area 0
  !
  tunnel source GigabitEthernet 1.700
  tunnel destination 169.254.0.1
  tunnel key {{ item.node.number | default('# MISSING! #') }}
  tunnel vrf HSRL_UNDERLAY
  tunnel protection ipsec profile IPSEC_PROFILE_HSRL_TUNNEL
  !
  no shutdown
!
router ospfv3 21
  address-family ipv4 unicast
    no passive-interface Tunnel8191812
  exit-address-family
!
#############
# NIPR Crypto
#############
crypto ikev2 proposal IKEV2_PROPOSAL_NIPR
  encryption aes-cbc-256
  integrity sha384
  group 20
no crypto ikev2 proposal default
!
crypto ikev2 policy IKEV2_POLICY_NIPR 
  proposal IKEV2_PROPOSAL_NIPR
!
crypto ikev2 keyring IKEV2_KEYRING_NIPR
  peer tactical
    description KEYRING FOR NIPR Tunnel
    address 0.0.0.0 0.0.0.0
    pre-shared-key local {{ item.nipr.interface.tunnel.ikev2.key | default('# MISSING! #') }}
    pre-shared-key remote {{ item.nipr.interface.tunnel.ikev2.key | default('# MISSING! #') }}
!
crypto ikev2 profile IKEV2_PROFILE_NIPR
  description NIPR IKE PROFILE
  match identity remote any
  authentication remote pre-share
  authentication local pre-share
  keyring local IKEV2_KEYRING_NIPR
  dpd 20 5 periodic
!
crypto ipsec transform-set IPSEC_XFORM_AES256_SHA384_NIPR esp-aes 256 esp-sha384-hmac
  mode transport
no crypto ipsec transform-set default
!
crypto ipsec profile IPSEC_PROFILE_NIPR
  description MATCH XFORM AND IKE PARAMETERS
  set transform-set IPSEC_XFORM_AES256_SHA384_NIPR 
  set ikev2-profile IKEV2_PROFILE_NIPR
no crypto ipsec profile default
!
#############
# NIPR Tunnel
#############
interface tunnel {{ item.nipr.interface.tunnel.number | default('# MISSING! #') }}
  shutdown
  description NIPR over Colorless Tunnel
  vrf forwarding NIPR_ROUTER
  !
  qos pre-classify
  !
  ip address {{ item.nipr.interface.tunnel.ip.address | default('# MISSING! #') }} {{ item.nipr.interface.tunnel.ip.netmask | default('# MISSING! #') }}
  no ip redirects
  no ip proxy-arp
  !
  ip nhrp nhs {{ item.nipr.interface.tunnel.ip.rhn_tunnel_ip | default('# MISSING! #') }} nbma {{ item.nipr.interface.tunnel.ip.rhn_anycast_ip | default('# MISSING! #') }} multicast
  ip nhrp redirect
  ip nhrp shortcut
  ip nhrp network-id {{ item.nipr.interface.tunnel.number | default('# MISSING! #') }}
  ip nhrp authentication {{ item.nipr.interface.tunnel.number | default('# MISSING! #') }}
  no ip nhrp map multicast dynamic
  !
  # match MTU/MSS to tunnel info in ACAS
  ip mtu {{ item.nipr.interface.tunnel.ip.mtu | default('# MISSING! #') }}
  ip tcp adjust-mss {{ item.nipr.interface.tunnel.ip.mss | default('# MISSING! #') }}
  ip pim nbma-mode
  ip pim sparse-mode
  qos pre-classif
  !
  ip ospf authentication message-digest
  ip ospf message-digest-key 1 md5 {{ item.nipr.interface.tunnel.ospf.key | default('# MISSING! #') }}
  ip ospf network point-to-multipoint
  ip ospf 21 area 0
  ip ospf cost {{ item.nipr.interface.tunnel.ospf.cost | default('# MISSING! #') }}
  !
  tunnel mode gre multipoint
  tunnel protection ipsec profile IPSEC_PROFILE_NIPR
  tunnel key {{ item.nipr.interface.tunnel.number | default('# MISSING! #') }}
  tunnel source loop 0
  !
  no shutdown
!
router ospf 21 vrf NIPR_ROUTER
  no passive-interface Tunnel{{ item.nipr.interface.tunnel.number | default('# MISSING! #') }}
!
