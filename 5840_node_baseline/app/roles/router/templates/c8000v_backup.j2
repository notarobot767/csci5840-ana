#######
# codec
#######
voice class codec 1
codec preference 1 g711ulaw
codec preference 2 g711alaw
codec preference 3 g729r8
!
############
# keep alive
############
voice class sip-options-keepalive 10
  description Keep SIP Trunk TCP Alive
  transport tcp
  up-interval 30
  down-interval 10
  retry 3
!
##############
# service voip
##############
voice service voip
  allow-connections sip to sip
  no supplementary-service h450.2
  no supplementary-service h450.3
  !
  sip
    bind all source-interface GigabitEthernet 1.58
    session transport udp
    registrar server
    no call service stop
    midcall-signaling passthru
    rel1xx supported "rel100"
    pass-thru headers unsupp
    asymmetric payload full
    asserted-id pai
    error-passthru
    referto-passing
!
#################
# register global
#################
voice register global
  mode cme
  # source-address {{ item.nipr.interface.voice.ip.address | default('# MISSING! #') }}
    # if using VRFs, must use a group to use that VRF plane for source-address
    # must also use the group in device pools
  group 1 vrf NIPR_VOICE
    source-address {{ item.nipr.interface.voice.ip.address | default('# MISSING! #') }}
  ntp-server {{ item.nipr.interface.loopback_7.ip.address | default('# MISSING! #') }}
  tftp-path flash:
  file text
  timezone {{ item.nipr.voip.timezone | default('# MISSING! #') }}
   # see context help for region
  time-format 24
  date-format D/M/Y
  max-dn 100
  max-pool 100
  # pick enough range of dn & pool to fit auto register and
  # space for manual entries
  # auto will start at lower end of dn/pool
  !
  #camera
  #video
  # enable if have video phones
  !
  # if desired
  # I found it more of a pain
  no auto-register
    #password Cisco1
    #auto-assign 646601 to 6466089
    # typical node gets last two digits of assignment (100 numbers)
    # if auto register, dont need to add register dn or pool manually
    # you may want to go back and edit the dn for the user title
  !
  # link load files
  # 7941, 7961
  load 7941 SIP41.9-3-1SR4-1S
  load 7941GE SIP41.9-3-1SR4-1S
  load 7961 SIP41.9-3-1SR4-1S
  !
  # 7942, 7962
  load 7942 SIP42.9-3-1SR4-1S
  load 7962 SIP42.9-3-1SR4-1S
  !
  # 7945, 7965
  load 7945 SIP45.9-4-2SR4-3S
  load 7965 SIP45.9-4-2SR4-3S
  !
  # 7975
  load 7975 SIP75.9-4-2SR4-3S
  !
  # 7811, 7821, 7841, 7861
  load 7811 sip78xx.14-4-1-0301-6.loads
  load 7821 sip78xx.14-4-1-0301-6.loads
  load 7841 sip78xx.14-4-1-0301-6.loads
  load 7861 sip78xx.14-4-1-0301-6.loads
  !
  # 8811, 8841, 8851, 8851NR, 8861
  load 8811 sip88xx.14-4-1-0301-6.loads
  load 8841 sip88xx.14-4-1-0301-6.loads
  load 8851 sip88xx.14-4-1-0301-6.loads
  load 8851NR sip88xx.14-4-1-0301-6.loads
  load 8861 sip88xx.14-4-1-0301-6.loads
  !
  # 8831
  load 8831 sip8831.10-3-1SR7-2.loads
  !
  # 8832
  load 8832 sip8832.14-4-1-0301-6.loads
  !
  # 8845
  load 8845 sip8845_65.14-4-1-0001-36.loads
!
############
# soft phone
############
voice register dn 1
  number {{ item.node.number | default('# MISSING! #') }}01
  label {{ item.node.type | default('# MISSING! #') }}-{{ item.node.number | default('# MISSING! #') }}
  name {{ item.node.type | default('# MISSING! #') }}-{{ item.node.number | default('# MISSING! #') }}
!
voice register pool 1
  id mac AAAA.AAAA.AAAA
  number 1 dn 1
  group 1
  dtmf-relay rtp-nte
  voice-class codec 1
  username {{ item.node.number | default('# MISSING! #') }}01 password Cisco123
  no vad
!
############
# hard phone
############
voice register dn 2
  number {{ item.node.number | default('# MISSING! #') }}02
  label {{ item.node.type | default('# MISSING! #') }}-{{ item.node.number | default('# MISSING! #') }}
  name {{ item.node.type | default('# MISSING! #') }}-{{ item.node.number | default('# MISSING! #') }}
!
voice register pool 2
  id mac 001D.A2F3.D1EC
    # update to your MAC
  type 7941GE
    # update to your model
  number 1 dn 2
  group 1
  dtmf-relay rtp-nte
  voice-class codec 1
  username {{ item.node.number | default('# MISSING! #') }}02 password Cisco123
  description {{ item.nipr.voip.prefix | default('# MISSING! #') }}02
  no vad
  speed-dial 1 2452002 label "RHN Bragg"
  speed-dial 2 2452400 label "GAIT NSC"
!
##################
# create profile #
##################
# enter this cmd after making modifications to dn or pool
voice register global
  create profile
!
#########
# trunk #
#########
!
voice class server-group 1
 ipv4 150.196.224.90
 ipv4 150.196.224.91
 description RHN Bragg CUCM
!
dial-peer voice 1000 voip
  description RHN Bragg Any 7
  destination-pattern [1-9]......
  session protocol sipv2
  session transport tcp
  session server-group 1
  voice-class codec 1 offer-all
  voice-class sip options-keepalive profile 10
  dtmf-relay rtp-nte
  ip qos dscp 49 media
  ip qos dscp cs5 signaling
  no vad
!
dial-peer voice 1005 voip
  description RHN Bragg Any 10
  destination-pattern [1-9].........
  session protocol sipv2
  session transport tcp
  session server-group 1
  voice-class codec 1 offer-all
  voice-class sip options-keepalive profile 10
  dtmf-relay rtp-nte
  ip qos dscp 49 media
  ip qos dscp cs5 signaling
  no vad
!
############
# hunt group
############
! make phones ring like a call center
!
# list phone numbers
# set number to ring
voice hunt-group 1 parallel
  list {{ item.node.number | default('# MISSING! #') }}01,{{ item.node.number | default('# MISSING! #') }}02
  pilot {{ item.node.number | default('# MISSING! #') }}00
  name "{{ item.node.type | default('# MISSING! #') }}-{{ item.node.number | default('# MISSING! #') }}"
!
{% endif %}
{% if item.comm is defined %}
###########
# COMM OSPF
###########
vrf definition COMM_ROUTER
  address-family ipv4
  address-family ipv6
!
router ospfv3 100
  address-family ipv4 vrf COMM_ROUTER
    timers throttle lsa 50 1000 5000
    passive-interface default
    router-id {{ item.comm.interface.loop_8.ip.address }}
!
###########
# COMM Data
###########
interface GigabitEthernet 1.959
  shutdown
  description COMM Data
  vrf forwarding COMM_ROUTER
  encapsulation dot1Q 959
{% if item.comm.interface.data is defined %}
  !
  ip addr {{ item.comm.interface.data.ip.address }} {{ item.comm.interface.data.ip.netmask }}
  no ip proxy-arp
  no ip redirects
  !
  ipv6 enable
  ospfv3 100 ipv4 area 0
  !
  no shutdown
{% else %}
  # ip address
    # warning: not defined
{% endif %}
!
############
# COMM Voice
############
interface GigabitEthernet 1.958
  shutdown
  description COMM Voice
  vrf forwarding COMM_ROUTER
  encapsulation dot1Q 958
{% if item.comm.interface.voice is defined %}
  !
  ip addr {{ item.comm.interface.voice.ip.address }} {{ item.comm.interface.voice.ip.netmask }}
  no ip proxy-arp
  no ip redirects
  !
  ipv6 enable
  ospfv3 100 ipv4 area 0
  !
  no shutdown
{% else %}
  # ip address
    # warning: not defined
{% endif %}
!
###########
# COMM MGMT
###########
interface GigabitEthernet 1.922
  shutdown
  description COMM MGMT
  vrf forwarding COMM_ROUTER
  encapsulation dot1Q 922
{% if item.comm.interface.mgmt is defined %}
  !
  ip addr {{ item.comm.interface.mgmt.ip.address }} {{ item.comm.interface.mgmt.ip.netmask }}
  no ip proxy-arp
  no ip redirects
  !
  ipv6 enable
  ospfv3 100 ipv4 area 0
  !
  no shutdown
{% else %}
  # ip address
    # warning: not defined
{% endif %}
!
#############
# COMM Crypto
#############
key chain KC_OSPFV3_COMM_AUTH
key 1
key-string 7 0229376B2D305C1E6F6124343A36273F24
cryptographic-algorithm hmac-sha-512
!
ip tcp synwait-time 10
!
crypto logging session
crypto logging ikev2
!
crypto ikev2 proposal IKEV2_PROPOSAL_COMM
encryption aes-cbc-256
integrity sha384
group 20
!
crypto ikev2 policy IKEV2_POLICY_COMM
match fvrf XLESS_UNDERLAY
proposal IKEV2_PROPOSAL_COMM
!
crypto ikev2 keyring IKEV2_KEYRING
peer COMM
address 10.208.0.0 255.254.0.0
pre-shared-key local IPSEC_COMM
pre-shared-key remote IPSEC_COMM
!
crypto ikev2 profile IKEV2_PROFILE_COMM
match fvrf XLESS_UNDERLAY
match identity remote address 10.208.0.0 255.254.0.0
authentication local pre-share
authentication remote pre-share
keyring local IKEV2_KEYRING
dpd 20 5 periodic
!
crypto ipsec transform-set IPSEC_XFORM_AH_SHA1 ah-sha-hmac
mode transport require
!
crypto ipsec profile IPSEC_PROFILE_AH_SHA1
set transform-set IPSEC_XFORM_AH_SHA1
set ikev2-profile IKEV2_PROFILE_COMM
!
#################
# COMM Loopback 8
#################
interface Loopback8
  description commercial
  vrf forwarding COMM_ROUTER
  ip address {{ item.comm.interface.loop_8.ip.address }} 255.255.255.255
  !
  no ip redirects
  no ip unreachables
  no ip proxy-arp
  ip pim sparse-dense-mode
  ipv6 enable
  ospfv3 100 ipv4 area 0
  ospfv3 network point-to-point
!
###################
# COMM Loopback 100
###################
interface Loopback100
  description xless (commercial underlay)
  ip address {{ item.xless.interface.loop_100.ip.address }} 255.255.255.255
  !
  no ip redirects
  no ip unreachables
  no ip proxy-arp
  !
  ipv6 enable
  no ipv6 redirects
  !
  ospfv3 21 ipv4 area 0
  ospfv3 21 ipv4 network point-to-point
!
############
# Tunnel 100
############
interface Tunnel100
  shutdown
  description commercial
  vrf forwarding COMM_ROUTER
  ip address {{ item.comm.interface.tunnel.ip.address }} {{ item.comm.interface.tunnel.ip.netmask }}
  !
  no ip redirects
  no ip unreachables
  ip mtu 1350
  ip tcp adjust-mss 1310
  !
  ip nhrp authentication COMM_35_
  ip nhrp network-id 100
  ip nhrp holdtime 600
  ip nhrp nhs dynamic nbma 10.208.251.247 multicast
  ip nhrp shortcut
  !
  ipv6 enable
  ipv6 address {{ item.comm.interface.tunnel.ipv6.address }}/{{ item.comm.interface.tunnel.ipv6.netmask }}
  ipv6 mtu 1350
  no ipv6 redirects
  no ipv6 unreachables
  ipv6 tcp adjust-mss 1290
  !
  ipv6 nhrp authentication COMM_35_
  ipv6 nhrp network-id 100
  ipv6 nhrp holdtime 600
  ipv6 nhrp nhs dynamic nbma 10.208.251.247 multicast
  ipv6 nhrp shortcut
  !
  ospfv3 100 network point-to-multipoint
  ospfv3 100 hello-interval 10
  ospfv3 100 authentication key-chain KC_OSPFV3_COMM_AUTH
  ospfv3 100 ipv4 area 0
  !
  tunnel source loopback 100
  tunnel mode gre multipoint
  tunnel key 100
  tunnel protection ipsec profile IPSEC_PROFILE_AH_SHA1
  !
  no shutdown
!
ip route vrf COMM_ROUTER 0.0.0.0 0.0.0.0 tun100 10.224.255.247 name COMM_GATEWAY
!
router ospfv3 100
  address-family ipv4 vrf COMM_ROUTER
    no passive-interface tunnel 100
    passive-interface Loopback 8
    passive-interface GigabitEthernet1.922
    passive-interface GigabitEthernet1.958
    passive-interface GigabitEthernet1.959
!
{% endif %}
end