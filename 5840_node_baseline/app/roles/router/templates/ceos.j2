hostname {{ item.hostname | default(hostname | default('# MISSING! #')) }}
system l1
  unsupported speed action error
  unsupported error-correction action error
!
#############
# Enable IPv6
#############
no ip routing
ipv6 unicast-routing
!
service routing protocols model multi-agent
no service interface inactive port-id allocation disabled
!
#######
# users
#######
{% if users is defined %}
{% for user in users %}
username {{ user.name }} privilege 15 role network-admin secret sha512 {{ user.secret }}
{% if user.ssh_key is defined %}
username {{ user.name }} ssh-key {{ user.ssh_key }}
{% endif %}
{% endfor %}
{% endif %}
!
aaa authorization exec default local
no aaa authorization config-commands
aaa accounting exec default start-stop logging
!
######
# misc
######
spanning-tree mode rapid-pvst
snmp-server community password ro
!
logging event login root
logging buffered 51200 warnings
logging host 2600:bad:c0de:cafe::10
logging format timestamp high-resolution
logging format hostname fqdn
logging format sequence-numbers
logging level default informational
!
management api http-commands
  no shutdown
!
ip route 0.0.0.0/0 172.20.20.1
!
{% set vlan_enabled = item.vlans | default(vlans | default(false)) %}
{% set v_list = vlans.nipr if (vlans is defined and vlans is mapping and vlans.nipr is defined) else (global_vlans.nipr if (global_vlans is defined and global_vlans.nipr is defined) else none) %}
{% if vlan_enabled and v_list %}
#######
# VLANs
#######
{% for v in v_list %}
vlan {{ v.vlan }}
{% if v.name is defined %}
   name {{ v.name }}
{% endif %}
!
{% endfor %}
{% endif %}
############
# Interfaces
############
{% set intf_dict = item.interfaces | default(interfaces | default({})) %}
{% for intf_name, intf in intf_dict.items() %}
interface {{ intf_name }}
{% if intf.description is defined %}
  description {{ intf.description }}
{% endif %}
{% if intf.switchport is defined %}
  {% if not intf.switchport %}
  no switchport
  {% else %}
  switchport
  {% if intf.switch is defined and intf.switch.address is defined %}
  switchport access vlan {{ intf.switch.address }}
  {% endif %}
  {% endif %}
{% endif %}
{% if intf['spanning-tree'] is defined %}
  {% if intf['spanning-tree'].portfast is defined %}
  spanning-tree portfast {{ intf['spanning-tree'].portfast }}
  {% endif %}
  {% if intf['spanning-tree'].bpduguard is defined and intf['spanning-tree'].bpduguard %}
  spanning-tree bpduguard enable
  {% endif %}
{% endif %}
{% if intf.ip is defined and intf.ip.address is defined %}
  ip address {{ intf.ip.address }}/{{ intf.ip.netmask | default('24') }}
{% endif %}
{% if intf.ipv6 is defined %}
  {% if intf.ipv6.enable is defined and intf.ipv6.enable %}
  ipv6 enable
  {% endif %}
  {% set ll_top = intf.ipv6.link_local | default(intf.ipv6['link-local'] | default(none)) %}
  {% if ll_top %}
  ipv6 address {{ ll_top }} link-local
  {% endif %}
  {% if intf.ipv6.address is defined %}
    {% if intf.ipv6.address is string %}
  ipv6 address {{ intf.ipv6.address }}/{{ intf.ipv6.netmask | default(intf.ipv6.mask | default('64')) }}
    {% elif intf.ipv6.address is iterable and intf.ipv6.address is not mapping %}
      {% set ns = namespace(has_split_ll=false, split_ll_addr=none) %}
      {% for entry in intf.ipv6.address %}
        {% if entry.link_local is defined and entry.link_local and entry.address is not defined %}
          {% set ns.has_split_ll = true %}
        {% endif %}
        {% if entry.address is defined and entry.mask is not defined and entry.netmask is not defined and entry.link_local is not defined %}
          {% set ns.split_ll_addr = entry.address %}
        {% endif %}
      {% endfor %}
      {% if ns.has_split_ll and ns.split_ll_addr %}
  ipv6 address {{ ns.split_ll_addr }} link-local
      {% endif %}
      {% for addr in intf.ipv6.address %}
        {% if addr.link_local is defined and addr.link_local and addr.address is defined %}
  ipv6 address {{ addr.address }} link-local
        {% elif addr.address is defined and (addr.netmask is defined or addr.mask is defined) %}
  ipv6 address {{ addr.address }}/{{ addr.netmask | default(addr.mask) }}
        {% elif addr.address is defined and not ns.has_split_ll %}
  ipv6 address {{ addr.address }}/64
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}
{% endif %}
{% if intf.isis is defined %}
  {% if intf.isis.enable is defined %}
  isis enable {{ intf.isis.enable | upper }}
  {% endif %}
  {% if intf.isis.metric is defined %}
  isis metric {{ intf.isis.metric }}
  {% endif %}
  {% if intf.isis.network is defined %}
  isis network {{ intf.isis.network }}
  {% endif %}
  {% if intf.isis.passive is defined and intf.isis.passive %}
  isis passive
  {% endif %}
{% endif %}
{% if intf.ospfv3 is defined and intf.ospfv3.process is defined %}
  {% for pid, pcfg in intf.ospfv3.process.items() %}
    {% if pcfg['passive-interface'] is defined and not pcfg['passive-interface'] %}
  no ospfv3 passive-interface
    {% endif %}
    {% if pcfg.ipv6 is defined %}
      {% if pcfg.ipv6['hello-interval'] is defined %}
  ospfv3 ipv6 hello-interval {{ pcfg.ipv6['hello-interval'] }}
      {% endif %}
      {% if pcfg.ipv6['dead-interval'] is defined %}
  ospfv3 ipv6 dead-interval {{ pcfg.ipv6['dead-interval'] }}
      {% endif %}
      {% set net_type = pcfg.ipv6.network | default(pcfg.ipv6.netmork | default(none)) %}
      {% if net_type %}
  ospfv3 ipv6 network {{ net_type }}
      {% endif %}
      {% if pcfg.ipv6.area is defined %}
  ospfv3 ipv6 area {{ pcfg.ipv6.area if '.' in (pcfg.ipv6.area | string) else (pcfg.ipv6.area | string) + '.0.0.0' if pcfg.ipv6.area == 0 else pcfg.ipv6.area }}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
!
{% endfor %}
############
# Route-Maps
############
{% set rmaps = item['route-map'] | default(route_map | default([])) %}
{% for rm in rmaps %}
{% set action = 'deny' if rm.deny is defined else 'permit' %}
{% set seq = rm.deny if rm.deny is defined else rm.permit %}
route-map {{ rm.map }} {{ action }} {{ seq }}
{% if rm.match is defined %}
{% for m in rm.match %}
{% if m.tag is defined %}
  match tag {{ m.tag }}
{% endif %}
{% endfor %}
{% endif %}
{% if rm.set is defined %}
{% for s in rm.set %}
{% if s['metric-type'] is defined %}
  set metric-type {{ s['metric-type'] }}
{% endif %}
{% if s.tag is defined %}
  set tag {{ s.tag }}
{% endif %}
{% endfor %}
{% endif %}
!
{% endfor %}
######
# ISIS
######
{% set isis_dict = item.isis | default(isis | default({})) %}
{% for inst_name, icfg in isis_dict.items() %}
router isis {{ inst_name | upper }}
{% if icfg.net is defined %}
  net {{ icfg.net }}
{% endif %}
{% if icfg['is-type'] is defined %}
  is-type {{ icfg['is-type'] }}
{% endif %}
  !
{% if icfg['address-family'] is defined %}
{% for af in icfg['address-family'] %}
{% if af.family is defined %}
  address-family {{ af.family }} unicast
{% endif %}
{% if af.redistribute is defined %}
{% for r in af.redistribute %}
    redistribute {{ r }}
{% endfor %}
{% endif %}
{% if af['multi-topology'] is defined and af['multi-topology'] %}
    multi-topology
{% endif %}
{% endfor %}
{% endif %}
!
{% endfor %}
########
# OSPFv3
########
{% set ospf_dict = item.ospfv3 | default(ospfv3 | default({})) %}
{% if ospf_dict %}
router ospfv3
{% for pid, pdata in ospf_dict.items() %}
{% if pdata['address-family'] is defined %}
{% for af in pdata['address-family'] %}
  address-family {{ af.family }}
{% if af.rid is defined %}
    router-id {{ af.rid }}
{% endif %}
{% if af['passive-interface'] is defined %}
    passive-interface {{ af['passive-interface'] }}
{% endif %}
{% if af.redistribute is defined %}
{% for r in af.redistribute %}
    redistribute {{ r }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
!
end